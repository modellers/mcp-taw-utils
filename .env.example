# ========================================
# Firebase Configuration (REQUIRED)
# ========================================
FIREBASE_PROJECT_ID=tasking-agency-is
FIREBASE_STORAGE_BUCKET=tasking-agency-is.appspot.com
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/tasking-agency-serviceaccount.json

# Multi-Project Firebase Sync (Optional)
FIREBASE_SOURCE_KEY_PATH=./secrets/tasking-agency-serviceaccount-is.json
FIREBASE_DEST_KEY_PATH=./secrets/tasking-agency-serviceaccount.json

# ========================================
# AI Service API Keys (Optional)
# ========================================
# OpenAI API
OPENAI_API_KEY=sk-...

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Google Generative AI
GOOGLE_API_KEY=AIza...

# Mistral AI
MISTRAL_API_KEY=...

# PremAI
PREMAI_API_KEY=...

# Tavily Search
TAVILY_API_KEY=...

# GitHub API (for discovery rate limits)
GITHUB_TOKEN=ghp_...

# ========================================
# Server Configuration
# ========================================
# MCP Server
MCP_SERVER_ENABLED=true
MCP_SERVER_PORT=3023        # 0 = disabled (stdio only)
MCP_TRANSPORT=stdio         # stdio | sse | both

# OpenAPI REST Server
API_SERVER_ENABLED=true
API_SERVER_PORT=3004        # 0 = disabled
API_AUTH_ENABLED=false
API_KEY=your-secret-api-key-here

# ========================================
# Optional Configuration
# ========================================
# LanceDB vector database location
LANCEDB_PATH=./.lancedb

# User ID mapping for Firebase sync (JSON format)
# USER_ID_MAP={"source-user-id": "dest-user-id"}
USER_ID_MAP={}

# Agent API base URL (for plugin discovery)
API_BASE_URL=http://localhost:3021

# ========================================
# Development Overrides
# ========================================
# NODE_ENV=development
# LOG_LEVEL=debug
