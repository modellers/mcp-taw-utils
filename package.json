{
  "name": "mcp-taw-utils",
  "version": "1.0.0",
  "description": "TAW Utils - MCP server for Firebase config management",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "start": "node dist/servers/index.js",
    "start:mcp": "MCP_SERVER_ENABLED=true API_SERVER_ENABLED=false node dist/servers/index.js",
    "start:api": "API_SERVER_ENABLED=true MCP_SERVER_ENABLED=false node dist/servers/index.js",
    "cli": "node dist/cli/index.js",
    "test": "vitest",
    "test:unit": "vitest run src/tools",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "mcp",
    "firebase",
    "server"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "chalk": "^5.0.0",
    "commander": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "firebase-admin": "^12.0.0",
    "ora": "^7.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "bin": {
    "taw-utils": "./dist/cli/index.js"
  }
}
